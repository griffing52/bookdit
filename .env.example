# bookdit configuration -- copy this file to `.env` and edit.
#
# Every machine-specific path the repo needs lives here. The parser
# (src/bookdit/utils/env.py) does not expand `~`, `$HOME` or `${VAR}`, so use
# absolute paths. An unset variable, or one still carrying the /ABSOLUTE/PATH/TO
# placeholder, raises SystemExit naming it (scripts/lib/_paths.py).


# --- Data roots -------------------------------------------------------------

# Root of the materialised LOBSTER cache: csv/, features/, tensors_event/, ...
LOBSTER_CACHE=/ABSOLUTE/PATH/TO/lobster_cache

# Directory holding the raw LOBSTER `.7z` archives. Corpus-build lane only.
LOBSTER_RAW_ROOT=/ABSOLUTE/PATH/TO/lobster_raw

# The event-level per-day corpus (*_event10_contig.pt) written by the corpus
# build. Defaults to <LOBSTER_CACHE>/tensors_event_contig when unset.
LOBSTER_CONTIG_ROOT=/ABSOLUTE/PATH/TO/lobster_cache/tensors_event_contig

# Fast local scratch for corpus-build temporaries (~50 GB free). Optional;
# falls back to the system temp dir.
LOBSTER_SCRATCH=/ABSOLUTE/PATH/TO/scratch


# --- Work and clone roots ---------------------------------------------------

# Root under which the LOB-Bench generation/scoring trees are written. Tens of GB.
BOOKDIT_WORK=/ABSOLUTE/PATH/TO/bookdit_work

# The LOB-S5 clone, patched with patches/lobs5-jax-compat.patch. Needed by
# the LOB-S5 baseline arm only, which needs the JAX stack in its own environment
# (docs/REPRODUCE.md §1.2).
LOBS5_DIR=/ABSOLUTE/PATH/TO/LOBS5

# The pinned lob_bench clone fetched by scripts/data/setup_libs.sh. Defaults to
# <repo>/libs/lob_bench, which is where that script writes it.
# LOB_BENCH_DIR=/ABSOLUTE/PATH/TO/lob_bench


# --- Decoder settings (not paths) -------------------------------------------
#
# Every book-state number in the paper uses IDM_GAP_PROFILE=1 and an effective
# 50-share resting-size deadband. Both are the code defaults
# (scripts/lib/idm_decoder.py: IDM_GAP_PROFILE=1, IDM_DEADBAND_ABS=50), so they are
# not normally set here. The Table 1 BookDiT rows apply the 50-share band in the
# decoder's quantized price space instead, via scripts/baselines/apply_deadband.py,
# which runs the decoder with IDM_DEADBAND_ABS=0; see docs/PROTOCOL.md §4.
